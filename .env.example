# Токен Discord-бота (Discord Developer Portal -> Bot -> Token). Обязателен.
DISCORD_TOKEN=

# ID сервера (гильдии) Discord, на котором работает бот. Обязателен.
GUILD_ID=

# Токен доступа к аккаунту Яндекс.Музыки (для доступа к «Моей волне»). Обязателен.
YANDEX_MUSIC_TOKEN=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR или CRITICAL. По умолчанию INFO.
LOG_LEVEL=INFO

# Громкость воспроизведения по умолчанию, диапазон 0.0..2.0. По умолчанию 0.5.
DEFAULT_VOLUME=0.5

# Путь к исполняемому файлу ffmpeg. По умолчанию ffmpeg (ищется в PATH).
FFMPEG_PATH=ffmpeg

# Время бездействия в секундах, после которого бот покидает голосовой канал. По умолчанию 300.
IDLE_TIMEOUT=300

# Токен доступа к сервису голосовой чат-рулетки nekto.me. Необязателен: без
# него бот работает как обычно, просто без команд рулетки. Как получить —
# см. раздел 6 README.md. Должен быть от того же браузера, что и
# NEKTO_USER_AGENT ниже (сервис их сверяет).
NEKTO_TOKEN=

# User-Agent браузера, которым был получен NEKTO_TOKEN. Обязателен, если
# задан NEKTO_TOKEN (и наоборот) — оба значения должны быть от одного и
# того же браузера.
NEKTO_USER_AGENT=

# Путь к модели Vosk для распознавания речи и голосовых команд («Катя, …»).
# По умолчанию models/vosk-model-small-ru-0.22 — как скачать модель, см.
# раздел README про распознавание речи. Без модели на диске бот всё равно
# запускается, распознавание лишь отключится с понятным предупреждением в
# логе при первом подключении к голосовому каналу.
SPEECH_MODEL_PATH=

# Включает распознавание речи и голосовые команды («Катя, …») в голосовом
# канале, где находится бот. По умолчанию ВКЛЮЧЕНО (1/true/yes/on — без
# учёта регистра; любое другое значение, включая 0/false/no — выключено).
# ВАЖНО про приватность: пока эта функция включена, бот постоянно
# распознаёт речь всех участников голосового канала — предупредите их
# заранее (см. раздел README про распознавание речи).
SPEECH_ENABLED=1

# Отладочная публикация КАЖДОЙ распознанной фразы (а не только голосовых
# команд) в текстовый канал. По умолчанию ВЫКЛЮЧЕНО — без явного включения
# это была бы утечка чужих разговоров в чат. Тот же формат булева значения,
# что и у SPEECH_ENABLED.
SPEECH_TRANSCRIPT=0

# Каталог отладочной ЗАПИСИ НА ДИСК всего, что слышит бот: WAV-файл на
# каждого говорящего (ровно тот звук, что уходит в распознавание),
# расшифровка и статистика потерь голосовых пакетов. Нужен, чтобы понять,
# из-за чего бот плохо распознаёт речь — из-за модели или из-за связи (см.
# раздел README про распознавание речи). Пустое значение — запись выключена,
# и это правильный режим для обычной работы: постоянно писать чужую речь на
# диск недопустимо. Включайте на время разбора проблемы.
SPEECH_DEBUG_DIR=

# Предел отладочной записи на одного говорящего, в секундах. 16 кГц моно —
# это примерно 1.9 МБ в минуту на человека, поэтому забытая включённой
# запись без предела съела бы гигабайты.
SPEECH_DEBUG_MAX_SECONDS=600

# Синтез речи — голосовая команда «повтори» и slash-команда /say: бот
# произносит фразу голосом в голосовом канале, приостанавливая музыку на её
# время. Включён по умолчанию. Модель (около 130 МБ) скачивается сама при
# первой произнесённой фразе, а не при старте, поэтому включённая настройка
# ничего не грузит и не замедляет запуск бота.
TTS_ENABLED=1

# Голос многоголосой модели: 0..4, у каждого своё звучание.
TTS_SPEAKER_ID=2

# Модель синтеза. Менять имеет смысл, только если нужен другой голос или
# качество: список моделей — на https://alphacephei.com/vosk/models
TTS_MODEL_NAME=vosk-model-tts-ru-0.7-multi

# Голосовые ответы бота на голосовые команды («Пауза», «Далее», «Волна» и
# т. п. — короткая реплика параллельно с самим выполнением команды).
# Включены по умолчанию вместе с TTS_ENABLED; выключите отдельно (0), если
# нужно, чтобы бот выполнял команды молча, без болтовни в ответ. Тот же
# формат булева значения, что и у SPEECH_ENABLED.
VOICE_REPLIES=1
